<Window x:Class="KlarWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KlarWin"
        Icon="pack://application:,,,/Assets/klarwin.ico"
        Height="920" Width="1180"
        MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Sitka Text"
        Foreground="#18241F">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C5D4C8" Offset="0"/>
            <GradientStop Color="#E7EFE8" Offset="0.45"/>
            <GradientStop Color="#B7C9B6" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <DockPanel>
        <Border x:Name="PromoLeft" DockPanel.Dock="Left" Width="280" Visibility="Collapsed"
                BorderBrush="#C5D4C8" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FAF7F0" Offset="0"/>
                    <GradientStop Color="#EDE8DC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image x:Name="PromoLeftLogo" Grid.Row="0" MaxWidth="240" Stretch="Uniform"
                       Margin="0,0,0,20" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Grid.Row="1" ClipToBounds="True" VerticalAlignment="Center">
                    <StackPanel x:Name="PromoLeftSlide" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PromoLeftTransform" X="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="PromoLeftTitle" FontFamily="Bahnschrift" FontSize="20" FontWeight="Bold"
                                   Foreground="#2F6A4A" TextWrapping="Wrap" LineHeight="24" Text="DG CRM"/>
                        <TextBlock x:Name="PromoLeftBody" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="18" Foreground="#3D4A44"
                                   Text="Kunden, Aufträge und Termine — klar organisiert."/>
                        <TextBlock x:Name="PromoLeftBullet" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#5A6B62" LineHeight="16" Text="Handwerk · Dienstleistung · CRM"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Stretch" MinHeight="44"
                        Style="{StaticResource PromoButton}" FontSize="14" Padding="12,10"
                        Content="Mehr erfahren →" Click="OnPromoClick"/>
            </Grid>
        </Border>
        <Border x:Name="PromoRight" DockPanel.Dock="Right" Width="280" Visibility="Collapsed"
                BorderBrush="#C5D4C8" BorderThickness="1,0,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FAF7F0" Offset="0"/>
                    <GradientStop Color="#EDE8DC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="20,22,20,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Image x:Name="PromoRightLogo" Grid.Row="0" MaxWidth="240" Stretch="Uniform"
                       Margin="0,0,0,20" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Grid.Row="1" ClipToBounds="True" VerticalAlignment="Center">
                    <StackPanel x:Name="PromoRightSlide" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PromoRightTransform" X="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="PromoRightTitle" FontFamily="Bahnschrift" FontSize="20" FontWeight="Bold"
                                   Foreground="#2F6A4A" TextWrapping="Wrap" LineHeight="24" Text="DG CRM"/>
                        <TextBlock x:Name="PromoRightBody" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"
                                   LineHeight="18" Foreground="#3D4A44"
                                   Text="Das CRM für Ihren Betrieb auf ganz-soft.de"/>
                        <TextBlock x:Name="PromoRightBullet" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="#5A6B62" LineHeight="16" Text="Handwerk · Dienstleistung · CRM"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="2" Margin="0,18,0,0" HorizontalAlignment="Stretch" MinHeight="44"
                        Style="{StaticResource PromoButton}" FontSize="14" Padding="12,10"
                        Content="Mehr erfahren →" Click="OnPromoClick"/>
            </Grid>
        </Border>
        <Border x:Name="PromoBottom" DockPanel.Dock="Bottom" Visibility="Visible"
                BorderBrush="#C5D4C8" BorderThickness="0,1,0,0" Padding="24,20" MinHeight="112">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FAF7F0" Offset="0"/>
                    <GradientStop Color="#F3EEE4" Offset="0.5"/>
                    <GradientStop Color="#FAF7F0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PromoBottomBrand" Grid.Column="0" Width="240" Stretch="Uniform"
                       Margin="0,0,28,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Grid.Column="1" ClipToBounds="True" VerticalAlignment="Center">
                    <StackPanel x:Name="PromoBottomSlide" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PromoBottomTransform" X="0"/>
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="PromoBottomTitle" FontFamily="Bahnschrift" FontSize="17" FontWeight="Bold"
                                   Foreground="#2F6A4A" TextWrapping="Wrap" LineHeight="22"
                                   Text="KUNDEN &amp; AUFTRÄGE. EIN SYSTEM."/>
                        <TextBlock x:Name="PromoBottomBody" Margin="0,4,0,0" FontSize="13" Foreground="#3D4A44"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Text="DG CRM für Handwerk und Dienstleistung — auf ganz-soft.de"/>
                        <TextBlock x:Name="PromoBottomBullet" Margin="0,4,0,0" FontSize="12" Foreground="#5A6B62"
                                   TextWrapping="Wrap" LineHeight="16"
                                   Text="Kunden · Angebote · Aufträge"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource PromoButton}" Padding="20,12" Margin="20,0,0,0"
                        MinHeight="44" FontSize="14" VerticalAlignment="Center"
                        Content="DG CRM ansehen →" Click="OnPromoClick"/>
            </Grid>
        </Border>

        <Grid Margin="48,20,48,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderDragArea" Background="Transparent" Cursor="SizeAll"
              PreviewMouseLeftButtonDown="OnHeaderDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="18"
                    BorderBrush="#2F6A4A" BorderThickness="2"
                    Background="Transparent" VerticalAlignment="Top">
                <Border CornerRadius="16" ClipToBounds="True" Background="Transparent" Margin="2">
                    <Image x:Name="HeaderLogo" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock x:Name="BrandTitle" FontFamily="Bahnschrift" FontSize="64" FontWeight="SemiBold"
                           Text="KlarWin" LineHeight="64"/>
                <TextBlock x:Name="BrandSubtitle" Margin="0,8,0,0" FontSize="20" Foreground="#4A5C54"
                           Text="Kachel anklicken — die Detailansicht öffnet sich in einem eigenen Fenster."/>
                <TextBlock x:Name="VersionLabel" Margin="0,6,0,0" FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239"
                           Text=""/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="16,8,0,0" Orientation="Horizontal" Cursor="Arrow">
                <Button x:Name="AdminElevateButton" Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0" VerticalAlignment="Top"
                        Content="Adminrechte freischalten" Click="OnAdminElevateClick"/>
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                        MinWidth="38" MinHeight="38" Padding="8,6" ToolTip="Einstellungen"
                        Click="OnSettingsClick" VerticalAlignment="Top">
                    <TextBlock FontSize="18" Text="⚙" Foreground="#8C6239" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="TileScrollViewer" Grid.Row="1" Margin="0,24,0,16" Padding="0,0,10,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
            <UniformGrid x:Name="TileGrid" Columns="3">
                <Button x:Name="TileClean" Style="{StaticResource TileButton}" Click="OnCleanClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="01  Speicher"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Bereinigen"/>
                        <StackPanel x:Name="TileCleanFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileSpeed" Style="{StaticResource TileButton}" Click="OnSpeedClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="02  Tempo"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Beschleunigen"/>
                        <StackPanel x:Name="TileSpeedFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TilePerf" Style="{StaticResource TileButton}" Click="OnPerfClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="03  Anzeige"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Leistung"/>
                        <StackPanel x:Name="TilePerfFeatures" Margin="0,2,0,0"/>
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" FontSize="11" Foreground="#4A5C54"/>
                                <TextBlock x:Name="CpuLabel" Grid.Column="1" Text="—" FontSize="11" Foreground="#2F6A4A"/>
                            </Grid>
                            <Canvas x:Name="TilePerfCpuChart" Height="26"/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM" FontSize="11" Foreground="#4A5C54"/>
                                <TextBlock x:Name="RamLabel" Grid.Column="1" Text="—" FontSize="11" Foreground="#2F6A4A"/>
                            </Grid>
                            <Canvas x:Name="TilePerfRamChart" Height="26"/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Temp" FontSize="11" Foreground="#4A5C54"/>
                                <TextBlock x:Name="TempLabel" Grid.Column="1" Text="—" FontSize="11" Foreground="#3B5A72"/>
                            </Grid>
                            <Canvas x:Name="TilePerfTempChart" Height="26"/>
                            <TextBlock x:Name="TilePerfHealthLabel" FontSize="11" Foreground="#4A5C54"
                                       Margin="0,6,0,0" TextWrapping="Wrap" Text="Gesundheit: —"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="TileOverlay" Style="{StaticResource TileButton}" Click="OnOverlayClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="04  Desktop"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Verknüpfungen"/>
                        <StackPanel x:Name="TileOverlayFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileAutostart" Style="{StaticResource TileButton}" Click="OnAutostartClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="05  Start"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Autostart"/>
                        <StackPanel x:Name="TileAutostartFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileWipe" Style="{StaticResource TileButton}" Click="OnWipeClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="06  Sicherheit"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Überschreiben"/>
                        <StackPanel x:Name="TileWipeFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="TileRecover" Style="{StaticResource TileButton}" Click="OnRecoverClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="07  Retten"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Wiederherstellen"/>
                        <StackPanel x:Name="TileRecoverFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileKeys" Style="{StaticResource TileButton}" Click="OnKeysClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="08  Lizenzen"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Keys sichern"/>
                        <StackPanel x:Name="TileKeysFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileNetwork" Style="{StaticResource TileButton}" Click="OnNetworkClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="09  Netz"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Netzwerk"/>
                        <StackPanel x:Name="TileNetworkFeatures" Margin="0,2,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓"/>
                            <Border Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,6,10,0">
                                <Rectangle x:Name="NetDownBar" Width="0" HorizontalAlignment="Left" Fill="#3B5A72"/>
                            </Border>
                            <TextBlock x:Name="NetDownLabel" Grid.Column="2" Text="—"/>
                            <TextBlock Grid.Row="1" Text="↑" Margin="0,8,0,0"/>
                            <Border Grid.Row="1" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,14,10,0">
                                <Rectangle x:Name="NetUpBar" Width="0" HorizontalAlignment="Left" Fill="#8C6239"/>
                            </Border>
                            <TextBlock x:Name="NetUpLabel" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Text="—"/>
                            <TextBlock Grid.Row="2" Text="Ping" Margin="0,8,0,0"/>
                            <TextBlock x:Name="NetPingLabel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,8,0,0" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Button>
                <Button x:Name="TileAi" Style="{StaticResource TileButton}" Click="OnAiClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="10  KI"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="KI-Last"/>
                        <StackPanel x:Name="TileAiFeatures" Margin="0,2,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU"/>
                            <Border Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,6,10,0">
                                <Rectangle x:Name="AiCpuBar" Width="0" HorizontalAlignment="Left" Fill="#2F6A4A"/>
                            </Border>
                            <TextBlock x:Name="AiCpuLabel" Grid.Column="2" Text="—"/>
                            <TextBlock Grid.Row="1" Text="RAM" Margin="0,8,0,0"/>
                            <Border Grid.Row="1" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,14,10,0">
                                <Rectangle x:Name="AiRamBar" Width="0" HorizontalAlignment="Left" Fill="#8C6239"/>
                            </Border>
                            <TextBlock x:Name="AiRamLabel" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Text="—"/>
                            <TextBlock Grid.Row="2" Text="GPU" Margin="0,8,0,0"/>
                            <Border Grid.Row="2" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,14,10,0">
                                <Rectangle x:Name="AiGpuBar" Width="0" HorizontalAlignment="Left" Fill="#3B5A72"/>
                            </Border>
                            <TextBlock x:Name="AiGpuLabel" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Button>
                <Button x:Name="TileUpdate" Style="{StaticResource TileButton}" Click="OnUpdateClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="11  Updates"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Apps &amp; Treiber"/>
                        <StackPanel x:Name="TileUpdateFeatures" Margin="0,2,0,0"/>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock FontSize="11" Foreground="#4A5C54" Text="Quellen"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#4A5C54" TextWrapping="Wrap"
                                       Text="winget · Microsoft Store · Windows Update"/>
                            <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#8C6239" TextWrapping="Wrap"
                                       Text="Updates in der Liste wählen und gemeinsam installieren."/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="TileBackup" Style="{StaticResource TileButton}" Click="OnBackupClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="12  Sicherung"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Win Sicherung"/>
                        <StackPanel x:Name="TileBackupFeatures" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileUsb" Style="{StaticResource TileButton}" Click="OnUsbClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="13  Medium"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="USB-Stick"/>
                        <StackPanel x:Name="TileUsbFeatures" Margin="0,2,0,0"/>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock FontSize="11" Foreground="#4A5C54" Text="Typische Formate"/>
                            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#4A5C54" TextWrapping="Wrap"
                                       Text="NTFS · exFAT · FAT32"/>
                            <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="#8C6239" TextWrapping="Wrap"
                                       Text="Linux-Stick? Hier für Windows umformatieren."/>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button x:Name="TileTransfer" Style="{StaticResource TileButton}" Click="OnTransferFoldersClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="14  Transfer"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Up-/Download"/>
                        <StackPanel x:Name="TileTransferFeatures" Margin="0,2,0,0"/>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock FontSize="11" Foreground="#4A5C54" TextWrapping="Wrap"
                                       Text="Eigene Zielordner — vor dem Dateidialog öffnen."/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </ScrollViewer>

        <!-- Unsichtbarer Host — Inhalt erscheint nur im Feature-Fenster nach Kachel-Klick -->
        <Grid x:Name="PanelChromeHost" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel x:Name="PanelHeaderHost">
                <TextBlock x:Name="PanelTitle" FontFamily="Bahnschrift" FontSize="18" Text=""/>
            </StackPanel>
            <TextBlock x:Name="PanelBody" Margin="0,6,0,0" FontSize="15" Foreground="#4A5C54"
                       TextWrapping="Wrap" Text=""/>
            <StackPanel x:Name="PanelButtonHost" Orientation="Horizontal">
                <ComboBox x:Name="FilterBox" Width="160" Margin="0,0,10,0" Visibility="Collapsed"
                          VerticalContentAlignment="Center" FontFamily="Bahnschrift" FontSize="14"
                          SelectionChanged="OnFilterChanged"/>
                <ComboBox x:Name="WipeModeBox" Width="160" Margin="0,0,10,0" Visibility="Collapsed"
                          VerticalContentAlignment="Center" FontFamily="Bahnschrift" FontSize="14">
                    <ComboBoxItem Content="Nullen (1×)" IsSelected="True" Tag="ZeroFill"/>
                    <ComboBoxItem Content="DoD (3×)" Tag="Dod3Pass"/>
                    <ComboBoxItem Content="Gutmann (35×)" Tag="Gutmann35"/>
                </ComboBox>
                <Button x:Name="PrimaryAction" Style="{StaticResource ActionButton}"
                        Content="Ausführen" Click="OnPrimaryAction" Visibility="Collapsed"/>
                <Button x:Name="SecondaryAction" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Content="Zurücksetzen" Click="OnSecondaryAction" Visibility="Collapsed"/>
                <Button x:Name="TertiaryAction" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Content="Mehr" Click="OnTertiaryAction" Visibility="Collapsed"/>
                <Button x:Name="QuaternaryAction" Style="{StaticResource GhostButton}"
                        Margin="10,0,0,0" Content="Weiter" Click="OnQuaternaryAction" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="DetailContentHost">
                <StackPanel x:Name="PerfDetailPanel" Margin="0,0,0,10" Visibility="Collapsed"/>
                <StackPanel x:Name="OptionsPanel" Visibility="Collapsed"/>
                <StackPanel x:Name="SpeedInputPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock FontSize="14" Foreground="#4A5C54" Text="Bildschirm-Timeout (Minuten, 0 = nie aus, leer = nicht ändern):"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Am Netzteil"/>
                        <TextBox x:Name="ScreenTimeoutAcBox" Width="64" FontSize="14" VerticalContentAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="16,0,8,0" Text="Am Akku"/>
                        <TextBox x:Name="ScreenTimeoutDcBox" Width="64" FontSize="14" VerticalContentAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="NetworkNotePanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="NetworkNoteHint" FontSize="14" Foreground="#4A5C54"
                               Text="Gerät in der Liste wählen, dann Bemerkung eintragen (z. B. Handy Chef Sohn)."/>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="NetworkNoteSaveButton" Style="{StaticResource ActionButton}"
                                DockPanel.Dock="Right" Content="Bemerkung speichern"
                                Click="OnNetworkNoteSave" Margin="10,0,0,0"/>
                        <TextBox x:Name="NetworkNoteBox" FontSize="14" VerticalContentAlignment="Center"
                                 MinHeight="32" IsEnabled="False"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel x:Name="UsbFormatPanel" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock FontSize="14" Foreground="#4A5C54" Text="Wechselmedium wählen (USB-Stick, SD-Karte …):"/>
                    <ComboBox x:Name="UsbDriveBox" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                              VerticalContentAlignment="Center" FontFamily="Bahnschrift" FontSize="14"
                              SelectionChanged="OnUsbDriveSelectionChanged"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="#4A5C54" Text="Ziel-Dateisystem (alle Daten auf dem Medium gehen verloren):"/>
                    <ComboBox x:Name="UsbFileSystemBox" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                              VerticalContentAlignment="Center" FontFamily="Bahnschrift" FontSize="14">
                        <ComboBoxItem Content="NTFS — Windows, große Dateien" IsSelected="True" Tag="NTFS"/>
                        <ComboBoxItem Content="exFAT — Windows &amp; andere Systeme (empfohlen für große Sticks)" Tag="exFAT"/>
                        <ComboBoxItem Content="FAT32 — UEFI / Installations-Stick (max. 4 GB pro Datei, bis ca. 32 GB)" Tag="FAT32"/>
                    </ComboBox>
                </StackPanel>
                <ProgressBar x:Name="PanelProgressBar" Height="10" Margin="0,10,0,6" Visibility="Collapsed"
                             Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="#2F6A4A"/>
                <TextBlock x:Name="PanelProgressText" Visibility="Collapsed" FontSize="13" Foreground="#4A5C54"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                <ListView x:Name="DetailGrid" Margin="0,8,0,0" MinHeight="80"
                          Visibility="Collapsed" FontSize="14" BorderBrush="#C3D1C8" Background="#FBFDFA"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnDetailGridSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Eintrag" Width="220" DisplayMemberBinding="{Binding Col1}"/>
                            <GridViewColumn Header="Details" Width="280" DisplayMemberBinding="{Binding Col2}"/>
                            <GridViewColumn Header="Info" Width="180" DisplayMemberBinding="{Binding Col3}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
