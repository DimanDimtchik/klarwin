<Window x:Class="KlarWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KlarWin"
        Height="820" Width="1100"
        MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        FontFamily="Sitka Text"
        Foreground="#18241F">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C5D4C8" Offset="0"/>
            <GradientStop Color="#E7EFE8" Offset="0.45"/>
            <GradientStop Color="#B7C9B6" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="48,36,48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontFamily="Bahnschrift" FontSize="64" FontWeight="SemiBold"
                       Text="KlarWin" LineHeight="64"/>
            <TextBlock Margin="0,8,0,0" FontSize="20" Foreground="#4A5C54"
                       Text="Windows aufräumen, beschleunigen, im Blick behalten."/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="0,28,0,20">
            <Button Style="{StaticResource TileButton}" Margin="0,0,12,12" Click="OnCleanClick" Tag="clean">
                <StackPanel>
                    <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="01  Speicher"/>
                    <TextBlock FontFamily="Bahnschrift" FontSize="32" Margin="0,10,0,6" Text="Bereinigen"/>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Foreground="#4A5C54"
                               Text="Temp-Dateien, Papierkorb und Download-Reste entfernen. Dokumente bleiben unberührt."/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Margin="12,0,0,12" Click="OnSpeedClick" Tag="speed">
                <StackPanel>
                    <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="02  Tempo"/>
                    <TextBlock FontFamily="Bahnschrift" FontSize="32" Margin="0,10,0,6" Text="Beschleunigen"/>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Foreground="#4A5C54"
                               Text="Energieplan auf Hochleistung, weniger Animationen, DNS-Cache leeren."/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Margin="0,12,12,0" Click="OnPerfClick" Tag="perf">
                <StackPanel>
                    <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="03  Anzeige"/>
                    <TextBlock FontFamily="Bahnschrift" FontSize="32" Margin="0,10,0,6" Text="Leistung"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU"/>
                        <Border Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,6,12,0">
                            <Rectangle x:Name="CpuBar" Width="0" HorizontalAlignment="Left" Fill="#2F6A4A"/>
                        </Border>
                        <TextBlock x:Name="CpuLabel" Grid.Column="2" Text="—"/>
                        <TextBlock Grid.Row="1" Text="RAM" Margin="0,10,0,0"/>
                        <Border Grid.Row="1" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,16,12,0">
                            <Rectangle x:Name="RamBar" Width="0" HorizontalAlignment="Left" Fill="#8C6239"/>
                        </Border>
                        <TextBlock x:Name="RamLabel" Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="—"/>
                        <TextBlock Grid.Row="2" Text="Disk" Margin="0,10,0,0"/>
                        <Border Grid.Row="2" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,16,12,0">
                            <Rectangle x:Name="DiskBar" Width="0" HorizontalAlignment="Left" Fill="#3B5A72"/>
                        </Border>
                        <TextBlock x:Name="DiskLabel" Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Text="—"/>
                    </Grid>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource TileButton}" Margin="12,12,0,0" Click="OnOverlayClick" Tag="overlay">
                <StackPanel>
                    <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="04  Desktop"/>
                    <TextBlock FontFamily="Bahnschrift" FontSize="32" Margin="0,10,0,6" Text="Verknüpfungen"/>
                    <TextBlock FontSize="16" TextWrapping="Wrap" Foreground="#4A5C54"
                               Text="Den kleinen Pfeil auf Desktop-Symbolen ausblenden oder wiederherstellen."/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Border Grid.Row="2" Background="#F4F8F5" BorderBrush="#C3D1C8" BorderThickness="1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PanelTitle" FontFamily="Bahnschrift" FontSize="18" Text="Wähle eine Kachel"/>
                    <TextBlock x:Name="PanelBody" Margin="0,6,0,0" FontSize="15" Foreground="#4A5C54"
                               TextWrapping="Wrap"
                               Text="Jede Kachel erledigt eine Sache. Der Fortschritt erscheint hier."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrimaryAction" Style="{StaticResource ActionButton}"
                            Content="Ausführen" Click="OnPrimaryAction" Visibility="Collapsed"/>
                    <Button x:Name="SecondaryAction" Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" Content="Zurücksetzen" Click="OnSecondaryAction" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
