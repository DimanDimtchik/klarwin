<Window x:Class="KlarWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KlarWin"
        Height="920" Width="1180"
        MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontFamily="Sitka Text"
        Foreground="#18241F">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C5D4C8" Offset="0"/>
            <GradientStop Color="#E7EFE8" Offset="0.45"/>
            <GradientStop Color="#B7C9B6" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="48,36,48,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="Auto" MinHeight="160"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontFamily="Bahnschrift" FontSize="64" FontWeight="SemiBold"
                       Text="KlarWin" LineHeight="64"/>
            <TextBlock Margin="0,8,0,0" FontSize="20" Foreground="#4A5C54"
                       Text="Aufräumen, sichern, wiederherstellen — eine Sache pro Kachel."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,24,0,16" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="3">
                <Button Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="OnCleanClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="01  Speicher"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Bereinigen"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Temp, Cache und Papierkorb. Mit Vorschau, bevor etwas gelöscht wird."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="5,0,5,10" Click="OnSpeedClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="02  Tempo"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Beschleunigen"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Hochleistung, weniger Animationen, DNS-Cache leeren."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="10,0,0,10" Click="OnPerfClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="03  Anzeige"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Leistung"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU"/>
                            <Border Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,6,10,0">
                                <Rectangle x:Name="CpuBar" Width="0" HorizontalAlignment="Left" Fill="#2F6A4A"/>
                            </Border>
                            <TextBlock x:Name="CpuLabel" Grid.Column="2" Text="—"/>
                            <TextBlock Grid.Row="1" Text="RAM" Margin="0,8,0,0"/>
                            <Border Grid.Row="1" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,14,10,0">
                                <Rectangle x:Name="RamBar" Width="0" HorizontalAlignment="Left" Fill="#8C6239"/>
                            </Border>
                            <TextBlock x:Name="RamLabel" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Text="—"/>
                            <TextBlock Grid.Row="2" Text="Disk" Margin="0,8,0,0"/>
                            <Border Grid.Row="2" Grid.Column="1" Height="8" Background="#D5E0D8" Margin="8,14,10,0">
                                <Rectangle x:Name="DiskBar" Width="0" HorizontalAlignment="Left" Fill="#3B5A72"/>
                            </Border>
                            <TextBlock x:Name="DiskLabel" Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,10,10" Click="OnOverlayClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="04  Desktop"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Verknüpfungen"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Den Pfeil auf Desktop-Symbolen ausblenden oder wiederherstellen."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="5,0,5,10" Click="OnAutostartClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="05  Start"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Autostart"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Programme anzeigen, die mit Windows starten — und einzeln abschalten."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="10,0,0,10" Click="OnWipeClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="06  Sicherheit"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Überschreiben"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Freien Speicher mit Nullen (oder Gutmann) überschreiben — gelöschte Reste weg."/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource TileButton}" Margin="0,0,10,0" Click="OnRecoverClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="07  Retten"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Wiederherstellen"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Dateien aus dem Papierkorb zurückholen, bevor er geleert wird."/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="5,0,5,0" Click="OnKeysClick">
                    <StackPanel>
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="08  Lizenzen"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="28" Margin="0,8,0,6" Text="Keys sichern"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Windows-, Office- und weitere Software-Keys lokal als Textdatei sichern."/>
                    </StackPanel>
                </Button>
                <Border Margin="10,0,0,0" Background="#E8F0EA" BorderBrush="#C3D1C8" BorderThickness="1" Padding="28,26">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="Bahnschrift" FontSize="13" Foreground="#8C6239" Text="Hinweis"/>
                        <TextBlock FontFamily="Bahnschrift" FontSize="22" Margin="0,8,0,6" Text="Sicherheit zuerst"/>
                        <TextBlock FontSize="15" TextWrapping="Wrap" Foreground="#4A5C54"
                                   Text="Überschreiben betrifft nur freien Speicher — nicht deine Dateien. Keys bleiben auf diesem PC."/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F4F8F5" BorderBrush="#C3D1C8" BorderThickness="1" Padding="22,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PanelTitle" FontFamily="Bahnschrift" FontSize="18" Text="Wähle eine Kachel"/>
                        <TextBlock x:Name="PanelBody" Margin="0,6,0,0" FontSize="15" Foreground="#4A5C54"
                                   TextWrapping="Wrap"
                                   Text="Jede Kachel erledigt eine Sache. Fortschritt und Listen erscheinen hier."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <ComboBox x:Name="WipeModeBox" Width="160" Margin="0,0,10,0" Visibility="Collapsed"
                                  VerticalContentAlignment="Center" FontFamily="Bahnschrift" FontSize="14">
                            <ComboBoxItem Content="Nullen (1×)" IsSelected="True" Tag="ZeroFill"/>
                            <ComboBoxItem Content="DoD (3×)" Tag="Dod3Pass"/>
                            <ComboBoxItem Content="Gutmann (35×)" Tag="Gutmann35"/>
                        </ComboBox>
                        <Button x:Name="PrimaryAction" Style="{StaticResource ActionButton}"
                                Content="Ausführen" Click="OnPrimaryAction" Visibility="Collapsed"/>
                        <Button x:Name="SecondaryAction" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Content="Zurücksetzen" Click="OnSecondaryAction" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="DetailList" Grid.Row="2" Margin="0,12,0,0" MaxHeight="160"
                         Visibility="Collapsed" FontSize="14"
                         BorderBrush="#C3D1C8" Background="#FBFDFA"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>
    </Grid>
</Window>
