<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>KlarWin</RootNamespace>
    <AssemblyName>KlarWin</AssemblyName>
    <Product>KlarWin</Product>
    <Company>GanzSoft</Company>
    <Description>Windows aufräumen, beschleunigen, Netzwerk und KI-Last im Blick.</Description>
    <Version>1.3.75</Version>
    <AssemblyVersion>1.3.75.0</AssemblyVersion>
    <FileVersion>1.3.75.0</FileVersion>
    <InformationalVersion>1.3.75</InformationalVersion>
    <ApplicationIcon>Assets\klarwin.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Tools\Fido.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Fido-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\blank-overlay.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\browser-extension\klarwin-download\**\*">
      <Link>browser-extension\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.2" />
    <Resource Include="Assets\klarwin.ico" />
    <Resource Include="Assets\klarwin-icon.png" />
    <Resource Include="Assets\ganzsoft-icon.png" />
    <Resource Include="Assets\ganzsoft-wordmark.png" />
    <EmbeddedResource Include="Assets\browser-extension.zip" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>
</Project>
