<Window x:Class="KlarWin.AutostartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KlarWin — Autostart"
        Height="640" Width="920"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Sitka Text"
        Foreground="#18241F"
        Background="#FAF9F7">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontFamily="Bahnschrift" FontSize="22" Text="Autostart"/>
        <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,8,0,14" FontSize="14" Foreground="#64748B"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" BorderBrush="#E7E0D8" BorderThickness="1" Background="#FFFFFF" CornerRadius="8">
            <Grid>
                <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="Visible">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Subtitle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox x:Name="CandidateList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="13" Foreground="#64748B" Text="{Binding Subtitle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Left">
            <Button x:Name="BtnDisable" Style="{StaticResource ActionButton}" Margin="0,0,10,8"
                    Content="Auswahl deaktivieren" Click="OnDisableClick" Visibility="Collapsed"/>
            <Button x:Name="BtnEnable" Style="{StaticResource GhostButton}" Margin="0,0,10,8"
                    Content="Auswahl aktivieren" Click="OnEnableClick" Visibility="Collapsed"/>
            <Button x:Name="BtnAdd" Style="{StaticResource ActionButton}" Margin="0,0,10,8"
                    Content="Programm hinzufügen" Click="OnAddProgramsClick"/>
            <Button x:Name="BtnStartupFolder" Style="{StaticResource GhostButton}" Margin="0,0,10,8"
                    Content="Autostart-Ordner …" Click="OnStartupFolderClick"/>
            <Button x:Name="BtnStartLayout" Style="{StaticResource GhostButton}" Margin="0,0,10,8"
                    Content="Startlayout …" Click="OnStartLayoutClick"/>
            <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Margin="0,0,10,8"
                    Content="Zurück" Visibility="Collapsed" Click="OnBackClick"/>
            <Button x:Name="BtnConfirmAdd" Style="{StaticResource ActionButton}" Margin="0,0,10,8"
                    Content="Zum Autostart hinzufügen" Visibility="Collapsed" Click="OnConfirmAddClick"/>
        </WrapPanel>
    </Grid>
</Window>
