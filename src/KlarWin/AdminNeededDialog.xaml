<Window x:Class="KlarWin.AdminNeededDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KlarWin — Administratorrechte"
        Height="420" Width="560"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Sitka Text"
        Foreground="#18241F"
        Background="#FAF9F7"
        ShowInTaskbar="False">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontFamily="Bahnschrift" FontSize="20"
                   Text="Administratorrechte nötig"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,12" FontSize="14"
                   Foreground="#4A5C54" TextWrapping="Wrap"/>

        <Border Grid.Row="2" BorderBrush="#E7E0D8" BorderThickness="1" Background="#FFFFFF"
                CornerRadius="6" Padding="10,8" MinHeight="80">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailText" FontSize="13" TextWrapping="Wrap"
                           Foreground="#18241F"/>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="13" Foreground="#64748B"
                   TextWrapping="Wrap"
                   Text="Windows fragt danach nach Bestätigung (UAC). Nach dem Neustart setzt KlarWin die offenen Updates fort."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Padding="16,10"
                    Content="Später" IsCancel="True" Click="OnLaterClick"/>
            <Button Style="{StaticResource ActionButton}" Padding="16,10"
                    Content="Als Admin fortfahren" IsDefault="True" Click="OnElevateClick"/>
        </StackPanel>
    </Grid>
</Window>
